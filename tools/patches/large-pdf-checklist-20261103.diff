+"""Check editing a synthetic long PDF in the packaged Windows worker."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+from pypdf import PdfReader, PdfWriter
+from reportlab.pdfgen import canvas
+
+ROOT = Path(__file__).resolve().parents[1]
+result = json.loads((ROOT / 'build' / 'windows-run' / 'Build_Result.json').read_text(encoding='utf-8-sig'))
+if result.get('status') != 'passed':
+    raise RuntimeError('The Windows build did not pass')
+exe = Path(result['exe'])
+if not exe.is_file():
+    raise RuntimeError('The checked Windows executable is unavailable')
+
+with tempfile.TemporaryDirectory(prefix='viewer-pdf-edit-exe-') as directory:
+    root = Path(directory)
+    source, output = root / 'synthetic.pdf', root / 'edit.pdf'
+    writer = PdfWriter()
+    for _ in range(1722):
+        writer.add_blank_page(width=500, height=700)
+    with source.open('wb') as stream:
+        writer.write(stream)
+    before = hashlib.sha256(source.read_bytes()).hexdigest()
+    request = {'id': 1, 'op': 'edit', 'path': str(source), 'page': 792,
+               'payload': {'operation': {'kind': 'cover', 'rect': [10, 10, 20, 20], 'color': '#ffffff'},
+                           'output': str(output)}}
+    completed = subprocess.run([str(exe), '--pdf-worker'],
+        input=(json.dumps(request)+'\n').encode('ascii'), stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE, timeout=180)
+    messages = [json.loads(line) for line in completed.stdout.splitlines() if line.strip()]
+    if completed.returncode != 0 or not messages or not messages[-1].get('ok'):
+        raise RuntimeError('Frozen PDF edit failed: '+repr((completed.returncode, messages, completed.stderr[-1000:])))
+    if len(PdfReader(output).pages) != 1 or hashlib.sha256(source.read_bytes()).hexdigest() != before:
+        raise RuntimeError('Frozen edit did not preserve the source or produce one page')
+print('PDF edit worker passed: 1,722-page synthetic source, one-page edit, source unchanged')
+
+# Exercise analysis and text editing through the frozen worker, using only
+# synthetic content. This does not represent mouse selection in the GUI.
+def worker(request):
+    completed = subprocess.run([str(exe), '--pdf-worker'],
+        input=(json.dumps(request)+'\n').encode('ascii'), stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE, timeout=180)
+    messages = [json.loads(line) for line in completed.stdout.splitlines() if line.strip()]
+    if completed.returncode != 0 or not messages or not messages[-1].get('ok'):
+        raise RuntimeError('Frozen checklist worker failed: '+repr((completed.returncode, messages, completed.stderr[-1000:])))
+    return messages[-1]
+
+with tempfile.TemporaryDirectory(prefix='viewer-pdf-checklist-exe-') as directory:
+    root = Path(directory); source = root/'synthetic.pdf'; output = root/'edited.pdf'
+    c = canvas.Canvas(str(source), pagesize=(300, 250)); c.setFont('Helvetica', 10)
+    t = c.beginText(35, 150); t.setCharSpace(24); t.textOut('XXO'); c.drawText(t)
+    c.drawString(35, 100, 'ordinary words stay together'); c.showPage(); c.save()
+    before = hashlib.sha256(source.read_bytes()).hexdigest()
+    info = worker({'id':1, 'op':'editinfo', 'path':str(source), 'page':0})['info']
+    cells = [s for s in info['spans'] if s['text'] in ('X','O')]
+    if [s['text'] for s in cells] != ['X','X','O']:
+        raise RuntimeError('Frozen worker did not separate checklist symbols')
+    selected=cells[0]; r=selected['rect']
+    operation={'kind':'format','rect':r,'old_text':'X','text':'O',
+               'source_glyphs':selected['source_glyphs'],'font':'Helvetica',
+               'size':selected['size'],'bold':False,'color':'#000000','rotate':0,
+               'align':'left','strict_size':True,'target':[r[0],r[1]-3,r[0]+16,r[3]+8]}
+    worker({'id':2,'op':'edit','path':str(source),'page':0,
+            'payload':{'operation':operation,'output':str(output)}})
+    after=worker({'id':3,'op':'editinfo','path':str(output),'page':0})['info']
+    remaining=[s['text'] for s in after['spans'] if s['text'] in ('X','O') and s['rect'][0]>r[2]+5]
+    if remaining != ['X','O'] or not any(o.get('text')=='O' for o in after['objects']):
+        raise RuntimeError('Frozen worker did not preserve neighboring checklist symbols')
+    if hashlib.sha256(source.read_bytes()).hexdigest() != before:
+        raise RuntimeError('Frozen checklist edit changed its source')
+print('PDF edit worker passed: synthetic checklist symbols individually identified and edited')
diff --git a/scripts/sync_pdf_edit_capsule.py b/scripts/sync_pdf_edit_capsule.py
new file mode 100644
index 0000000..72170a3
--- /dev/null
+++ b/scripts/sync_pdf_edit_capsule.py
@@ -0,0 +1,67 @@
+"""Synchronize the frozen PDF worker's editable-page helpers from source.
+
+The executable's fast worker carries a compressed compatibility copy. Keep
+the edited helpers identical without embedding a giant opaque diff in the PR.
+"""
+from __future__ import annotations
+
+import ast
+import base64
+from pathlib import Path
+import zlib
+
+SOURCE = Path(__file__).resolve().parents[1] / 'pdf_page_dragger.py'
+NAMES = ('editable_copy', 'split_spaced_text_span', 'inspect_edit_page')
+
+
+def funcs(tree):
+    return {n.name: n for n in tree.body if isinstance(n, ast.FunctionDef)}
+
+
+def sync(source: str) -> str:
+    outer = ast.parse(source)
+    worker = funcs(outer)['_viewer_fast_pdf_worker']
+    calls = [n for n in ast.walk(worker) if isinstance(n, ast.Call)
+             and isinstance(n.func, ast.Attribute) and n.func.attr == 'b85decode'
+             and n.args and isinstance(n.args[0], ast.Constant)]
+    if len(calls) != 1:
+        raise ValueError('PDF worker compatibility capsule is ambiguous')
+    literal = calls[0].args[0]
+    encoded = ast.literal_eval(literal)
+    capsule = zlib.decompress(base64.b85decode(encoded)).decode('utf-8')
+    inner = ast.parse(capsule)
+    top, compat = funcs(outer), funcs(inner)
+    if not all(name in top for name in NAMES):
+        raise ValueError('Source PDF helper missing')
+    if not all(name in compat for name in ('editable_copy', 'inspect_edit_page')):
+        raise ValueError('Compatibility PDF helper missing')
+    replacements = []
+    for name in ('editable_copy', 'inspect_edit_page'):
+        node = compat[name]
+        replacement = ast.get_source_segment(source, top[name])
+        if name == 'inspect_edit_page' and 'split_spaced_text_span' not in compat:
+            replacement = ast.get_source_segment(source, top['split_spaced_text_span']) + '\n\n\n' + replacement
+        replacements.append((node.lineno - 1, node.end_lineno, replacement))
+    if 'split_spaced_text_span' in compat:
+        node = compat['split_spaced_text_span']
+        replacements.append((node.lineno - 1, node.end_lineno,
+                             ast.get_source_segment(source, top['split_spaced_text_span'])))
+    lines = capsule.splitlines(keepends=True)
+    for start, end, replacement in sorted(replacements, reverse=True):
+        lines[start:end] = [replacement + '\n']
+    new_capsule = ''.join(lines)
+    compile(new_capsule, 'PDF compatibility capsule', 'exec')
+    inner = funcs(ast.parse(new_capsule))
+    if any(ast.dump(top[name], include_attributes=False) != ast.dump(inner[name], include_attributes=False) for name in NAMES):
+        raise ValueError('Synchronized PDF helpers differ')
+    new_encoded = base64.b85encode(zlib.compress(new_capsule.encode('utf-8'), 9)).decode('ascii')
+    old_literal = ast.get_source_segment(source, literal)
+    if source.count(old_literal) != 1:
+        raise ValueError('PDF worker compatibility capsule is not unique')
+    return source.replace(old_literal, repr(new_encoded), 1)
+
+
+if __name__ == '__main__':
+    original = SOURCE.read_text(encoding='utf-8')
+    SOURCE.write_text(sync(original), encoding='utf-8', newline='\n')
+    print('Frozen PDF worker edit helpers synchronized')

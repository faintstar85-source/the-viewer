@@ -0,0 +1,77 @@
+"""A page edit must preserve appearance and annotations when extracted alone."""
+import io
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+from pypdf import PdfReader, PdfWriter
+from pypdf.annotations import Text
+from reportlab.pdfgen import canvas
+import pypdfium2 as pdfium
+import pdf_page_dragger as viewer
+import viewer_pdf_engine
+
+
+def render(data, number=0):
+    document = pdfium.PdfDocument(data)
+    page = document[number]
+    image = page.render(scale=1.2).to_pil()
+    result = image.size, image.tobytes()
+    page.close()
+    document.close()
+    return result
+
+
+class EditableCopyTests(unittest.TestCase):
+    def test_extract_rotated_page_preserves_content_and_annotation(self):
+        source_data = io.BytesIO()
+        c = canvas.Canvas(source_data, pagesize=(300, 420))
+        c.setFont('Helvetica-Bold', 16)
+        c.drawString(50, 200, 'Checklist value 42')
+        c.line(20, 80, 220, 80)
+        c.showPage()
+        c.save()
+        writer = PdfWriter()
+        for _ in range(12):
+            writer.add_blank_page(width=320, height=420)
+        writer.add_page(PdfReader(io.BytesIO(source_data.getvalue())).pages[0])
+        writer.pages[12].rotate(90)
+        writer.add_annotation(12, Text(rect=(10, 10, 25, 25), text='A note'))
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'source.pdf'
+            with path.open('wb') as file:
+                writer.write(file)
+            # Compare against the old extraction path; annotation appearance is
+            # renderer dependent but must be preserved in the PDF structure.
+            with viewer_pdf_engine.open(path) as source:
+                with viewer_pdf_engine.open() as old:
+                    old.insert_pdf(source, from_page=12, to_page=12)
+                    baseline = old.tobytes()
+            with viewer.editable_copy(str(path), 12, normalize_rotation=False) as page:
+                actual = page.tobytes()
+            expected_page = PdfReader(io.BytesIO(baseline)).pages[0]
+            actual_reader = PdfReader(io.BytesIO(actual))
+            actual_page = actual_reader.pages[0]
+            self.assertEqual(len(actual_reader.pages), 1)
+            self.assertEqual(actual_page.rotation, 90)
+            self.assertEqual(actual_page.extract_text(), expected_page.extract_text())
+            self.assertEqual(len(actual_page['/Annots']), 1)
+            self.assertEqual(actual_page['/Annots'][0].get_object()['/Contents'], 'A note')
+            self.assertEqual(render(actual), render(baseline))
+
+    def test_reject_invalid_page_number(self):
+        writer = PdfWriter()
+        writer.add_blank_page(width=300, height=420)
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'source.pdf'
+            with path.open('wb') as file:
+                writer.write(file)
+            for number in (-1, 1):
+                with self.subTest(number=number), self.assertRaises(IndexError):
+                    viewer.editable_copy(str(path), number)
+
+
+if __name__ == '__main__':
+    unittest.main()

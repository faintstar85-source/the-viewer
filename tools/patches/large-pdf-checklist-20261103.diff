+"""Widely spaced glyphs in a single PDF text operation remain independently editable."""
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+from reportlab.pdfgen import canvas
+import pypdfium2 as pdfium
+import pdf_page_dragger as viewer
+
+
+def page_pixels(path):
+    doc=pdfium.PdfDocument(str(path));page=doc[0]
+    image=page.render(scale=2).to_pil().convert('RGB')
+    size=image.size;pixels=image.tobytes()
+    page.close();doc.close()
+    return size,pixels
+
+
+class ChecklistCellEditTests(unittest.TestCase):
+    def test_one_glyph_in_spaced_text_object_can_be_replaced(self):
+        with tempfile.TemporaryDirectory() as directory:
+            src=Path(directory)/'source.pdf';out=Path(directory)/'edited.pdf'
+            c=canvas.Canvas(str(src),pagesize=(300,250));c.setFont('Helvetica',10)
+            c.saveState();text=c.beginText(35,150);text.setCharSpace(24);text.textOut('XXO');c.drawText(text);c.restoreState()
+            c.drawString(35,100,'ordinary words stay together');c.line(20,145,200,145);c.showPage();c.save()
+            before=viewer.inspect_edit_page(str(src),0)
+            cells=[s for s in before['spans'] if s['text'] in ('X','O')]
+            self.assertEqual([s['text'] for s in cells],['X','X','O'])
+            self.assertTrue(any(s['text']=='ordinary words stay together' for s in before['spans']))
+            selected=cells[0];r=selected['rect']
+            self.assertIs(viewer.nearest_text_hit(before['spans'],[(r[0]+r[2])/2,(r[1]+r[3])/2],2),selected)
+            operation={'kind':'format','rect':r,'old_text':'X','text':'O',
+                       'source_glyphs':selected['source_glyphs'],'font':'Helvetica',
+                       'size':selected['size'],'bold':False,'color':'#000000','rotate':0,
+                       'align':'left','strict_size':True,'target':[r[0],r[1]-3,r[0]+16,r[3]+8]}
+            viewer.apply_page_edit(str(src),0,operation,str(out))
+            after=viewer.inspect_edit_page(str(out),0)
+            native=[s for s in after['spans'] if s['text'] in ('X','O') and s['rect'][0]>r[2]+5]
+            self.assertEqual([s['text'] for s in native],['X','O'])
+            self.assertTrue(any(o.get('text')=='O' for o in after['objects']))
+            self.assertTrue(any(s['text']=='ordinary words stay together' for s in after['spans']))
+            size,a=page_pixels(src);size2,b=page_pixels(out);self.assertEqual(size,size2)
+            # The table line and every pixel outside the chosen cell are exact.
+            width,height=size;changed=0
+            for y in range(height):
+                for x in range(width):
+                    i=(y*width+x)*3
+                    if a[i:i+3]!=b[i:i+3]:
+                        changed+=1
+                        self.assertTrue((r[0]-2)*2<=x<=(r[0]+18)*2 and (r[1]-5)*2<=y<=(r[3]+10)*2)
+            self.assertGreater(changed,0)
+
+    def test_rotated_spans_are_left_unchanged(self):
+        chars=[{'c':'X','bbox':[0,0,4,4],'origin':[0,0]},
+               {'c':'X','bbox':[30,0,34,4],'origin':[30,0]}]
+        self.assertIs(viewer.split_spaced_text_span({'chars':chars,'size':10},90)[0],chars)
+
+
+if __name__=='__main__':unittest.main()
